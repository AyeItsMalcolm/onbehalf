# Copy to .env and fill in locally. Names only here. Never commit .env.
# RECEIPT_SIGNING_KEY  Ed25519 private key, PKCS8 DER, base64. Created by `pnpm keygen`.
# The three anchor variables are NOT used in the demo (PBX-021). The anchor
# script and verifier anchor check read them, but the demo never runs them and
# no chain key is created or stored. Leave them empty.
# ANCHOR_PRIVATE_KEY   0x-prefixed EVM private key for the anchor wallet.
# RPC_URL              A BNB Smart Chain testnet endpoint from the official BNB Chain docs.
# CHAIN_ID             97 for BNB Smart Chain testnet.
RECEIPT_SIGNING_KEY=
ANCHOR_PRIVATE_KEY=
RPC_URL=
CHAIN_ID=
